{
  "name": "React-Webpack",
  "version": "0.0.1",
  "description": "基于Webpack构建的React应用",
  "main": [
    {
      "keys": "index",
      "title": "webpack",
      "pathIndex": "./src/index.js",
      "chunks": [
        "index"
      ]
    }
  ],
  "license": "MIT",
  "scripts": {
    "start": "webpack serve --mode=development --env project=index --env prot=8080 --env environment=dev --config ./bin/webpack.config.js",
    "build": "webpack --mode=production --env project=index --env NODE_ENV=production --config ./bin/webpack.config.js"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-decorators": "^7.23.0",
    "@babel/plugin-proposal-object-rest-spread": "^7.20.7",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/plugin-transform-arrow-functions": "^7.22.5",
    "@babel/plugin-transform-object-assign": "^7.22.5",
    "@babel/plugin-transform-runtime": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@babel/preset-react": "^7.22.15",
    "autoprefixer": "^10.5.0",
    "babel-loader": "^9.1.3",
    "clean-webpack-plugin": "^4.0.0",
    "compression-webpack-plugin": "^10.0.0",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^6.8.1",
    "css-minimizer-webpack-plugin": "^5.0.1",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^5.5.3",
    "less": "^4.2.0",
    "less-loader": "^11.1.3",
    "mini-css-extract-plugin": "^2.7.6",
    "postcss": "^8.4.31",
    "postcss-loader": "^7.3.3",
    "postcss-safe-parser": "^6.0.0",
    "style-loader": "^3.3.3",
    "terser-webpack-plugin": "^5.3.9",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.0",
    "url-loader": "^4.1.1",
    "webpack": "^5.89.0",
    "webpack-bundle-analyzer": "^5.0.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1",
    "webpack-manifest-plugin": "^5.0.0"
  },
  "proxy": {
    "stats": "verbose",
    "data": {
      "/dev/*": {
        "target": "http://www.timemyh.com/api/",
        "pathRewrite": {
          "^/dev/": ""
        },
        "changeOrigin": true,
        "secure": false
      }
    }
  }
}
